tests {
  test("token válido -> 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("responde con sub=ana y role=user", function () {
    expect(res.body.sub).to.equal("ana");
    expect(res.body.role).to.equal("user");
  });
}

docs {
  Con el token legítimo de ana, svc-pagos (puerto 4001) responde quién eres
  según los claims del token. Funciona igual en modo vulnerable y en modo
  seguro, porque el token ES válido de verdad: esto NO es el ataque.
}
